{
  "project": "日本関連 海外オッズ相場表（iCurate）",
  "version": "2.0",
  "created": "2026-09-13",
  "source": "iCurate の姉妹プロジェクト（時計claude / 高級車claude / 高級レストランclaude）の Design DNA を継承。ユーザー要件「シンプルかつ高級感、見やすく」＋ icurate.net からリンクされる前提で同一ブランドの色・書体に統一。2026-09-20 ユーザー要望「ラスベガスの Wynn / Bellagio 風の高級感」で更新：オックスブラッド（深いワイン）と アイボリー、シャンパンゴールドの二重罫線、Didone（Bodoni Moda）の数字、Art Deco の◆飾り",
  "typography": {
    "personality": "editorial",
    "weight_preference": "light(300-400)",
    "mix_ja_en": true,
    "suggested_fonts": [
      "Bodoni Moda",
      "Shippori Mincho B1",
      "Noto Sans JP"
    ],
    "rules": [
      "見出しは欧文セリフ+和文明朝",
      "本文は和文ゴシック細字（Noto Sans JP 300/400）",
      "英字の小見出しはレタースペース0.2em以上の小型大文字",
      "数字は本文フォントで等幅（tabular-nums）",
      "UIに絵文字を使わない（分野名は英字小見出しで示す）"
    ]
  },
  "color": {
    "palette_type": "monochrome + single accent",
    "primary_hue": "warm",
    "contrast_level": "medium",
    "hex_palette": [
      "#EDE6DA",
      "#C9A96E",
      "#B8892A",
      "#6A93CF",
      "#857B6E",
      "#2E2823",
      "#1A1714",
      "#0F0D0B"
    ],
    "roles_dark": {
      "bg": "#180A0F",
      "surface": "#22111A",
      "line": "#4A2A34",
      "ink": "#F4E9D8",
      "accent_gold": "#D8B872",
      "gold_hi": "#F0D79A",
      "wine": "#6E1B2C"
    },
    "roles_light": {
      "bg": "#F5EFE3",
      "surface": "#FCF8F0",
      "line": "#D9C8B0",
      "ink": "#2A1018",
      "accent_gold": "#A8873F",
      "gold_hi": "#C9A85A",
      "wine": "#7A1F2E"
    },
    "chart_series_dark": [
      "#C9A96E",
      "#6A93CF",
      "#C97A88",
      "#8FB08A",
      "#A08BD6",
      "#D08050"
    ],
    "chart_series_light": [
      "#9C7C3C",
      "#3F6BB5",
      "#B5566A",
      "#4F8A5C",
      "#7A5FBF",
      "#B8652E"
    ],
    "market_convention": "相場表の慣例で 上昇＝赤系 / 下落＝緑系"
  },
  "layout": {
    "density": "airy",
    "structure": "grid",
    "whitespace_use": "generous",
    "max_width_px": 1280,
    "radius_px": 2,
    "rules": "金の二重罫線（3px double）で大区切り、カードは外枠＋5px内側の細い金枠の二重フレーム。上昇＝コーラル／下落＝ジェイド"
  },
  "motion": {
    "style": "subtle",
    "timing": "slow-luxury",
    "transition_css": "all .45s cubic-bezier(.2,.7,.2,1)"
  },
  "cultural_reference": [
    "luxury",
    "las-vegas-resort",
    "art-deco",
    "editorial",
    "japanese",
    "market-board"
  ],
  "anti_patterns": [
    "no_neon_colors",
    "no_heavy_gradients",
    "no_large_rounded_corners",
    "no_heavy_drop_shadows",
    "no_emoji_in_ui",
    "no_dual_axis_chart",
    "no_dashed_gridlines"
  ]
}